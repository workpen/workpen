{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/workpen/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/workpen-cli/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/workpen-cli/Cargo.toml",
          "jsonpath": "$.dependencies.workpen.version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "GOVERNANCE.md"
        },
        {
          "type": "generic",
          "path": "ROADMAP.md"
        },
        {
          "type": "generic",
          "path": "docs/threat-model.md"
        },
        {
          "type": "generic",
          "path": "crates/workpen/src/threat_model.rs"
        }
      ]
    }
  }
}
